# Copy to .env.local for local dev; set the same in Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://juyal-devashish.vercel.app
# Upstash Redis (added automatically by `vercel install upstash`)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# GitHub fine-grained token (public read). Recommended in Vercel: without it the calendar is scraped from
#   github.com's public page (one calendar year per request); a year it cannot fully cover is hidden.
GITHUB_TOKEN=
# Page views on the year page (optional). Vercel Web Analytics API, read-only:
#   a Vercel access token (Account → Tokens), the project id (Project → Settings → General),
#   and the team id if the project belongs to a team. Web Analytics itself needs no env vars:
#   enable it in the Vercel dashboard (Project → Analytics); <Analytics /> loads only on Vercel.
# Without these, post views are counted in Upstash instead (POST /api/views, no cookies or IPs).
VERCEL_ANALYTICS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Local only: DEV_FIXTURES=1 shows sample numbers in the live widgets (never in production builds).
# DEV_FIXTURES=
