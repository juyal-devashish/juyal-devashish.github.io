{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": ["http://localhost/index.html", "http://localhost/papers.html"],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": { "categories:accessibility": ["error", { "minScore": 0.95 }] }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
