{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3200/",
        "http://127.0.0.1:3200/projects",
        "http://127.0.0.1:3200/stack",
        "http://127.0.0.1:3200/resume",
        "http://127.0.0.1:3200/photos",
        "http://127.0.0.1:3200/now",
        "http://127.0.0.1:3200/cmd",
